# Copy to .env, and generate a unique key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-secret-key
FLASK_DEBUG=0

# Configure public base URL only on deployed HTTPS sites.
PUBLIC_BASE_URL=

# Xendit test credentials; keep blank for offline checkout only.
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# Optional email notifications for customer reports (requires SMTP access).
SUPPORT_ADMIN_EMAIL=
SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_USERNAME=
SUPPORT_SMTP_PASSWORD=
SUPPORT_SMTP_FROM=

# Forgot Password uses the SUPPORT_SMTP settings above and requires PUBLIC_BASE_URL=https://your-site.example
